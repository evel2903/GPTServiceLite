{
    "name":  "evel-gpt-service-lite",
    "version":  "1.4.1",
    "private":  true,
    "description":  "Evel GPT Service Lite - Standalone web app for personal/workspace ChatGPT account change-2FA, check plan, and access token retrieval with in-place auto-update.",
    "main":  "server.js",
    "bin":  "server.js",
    "scripts":  {
                    "start":  "node server.js",
                    "test":  "node --test tests/*.test.js",
                    "build:exe":  "pkg . --targets node18-win-x64 --output dist/gptservicelite.exe",
                    "build:portable":  "powershell -ExecutionPolicy Bypass -File build-portable.ps1",
                    "dev":  "node --watch server.js"
                },
    "pkg":  {
                "outputPath":  "dist"
            },
    "dependencies":  {
                         "express":  "^4.19.2"
                     },
    "devDependencies":  {
                            "pkg":  "^5.8.1",
                            "vue":  "^3.5.13",
                            "primevue":  "^4.5.4",
                            "@primevue/themes":  "^4.5.4"
                        }
}